{
  "name": "privatix-site",
  "version": "1.0.0",
  "private": true,
  "description": "Privatix - site vitrine (servi à la racine, le jeu sous /jouer/, le prototype sous /3d/).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/fetch-releases.mjs && node scripts/presskit.mjs && tsc --noEmit && vite build",
    "build:offline": "node scripts/presskit.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-releases.mjs && node scripts/test-presskit.mjs",
    "check": "npm run typecheck && npm test",
    "presskit": "node scripts/presskit.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.15.0"
  }
}
